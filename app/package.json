{
  "name": "screensh",
  "version": "1.4.12",
  "description": "P2P Screen Sharing Application",
  "main": "main.js",
  "scripts": {
    "pack:win": "npm run build:process-audio && electron-builder --win nsis --publish never",
    "publish:win": "npm run build:process-audio && electron-builder --win nsis --publish always",
    "pack:portable": "npm run build:process-audio && node scripts/package-win.cjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "test:native": "node scripts/run-electron.cjs smoke-native.cjs",
    "test:media": "node scripts/run-electron.cjs smoke-electron.cjs",
    "test:ui": "node scripts/run-electron.cjs smoke-ui.cjs",
    "test:voice": "node scripts/run-electron.cjs smoke-voice.cjs",
    "test:mic-meter": "node scripts/run-electron.cjs smoke-mic-meter.cjs",
    "test:speaking": "node scripts/run-electron.cjs smoke-speaking.cjs",
    "test:voice-ui": "node scripts/run-electron.cjs smoke-voice-ui.cjs",
    "build:process-audio": "node scripts/build-process-audio.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^26.15.3",
    "rcedit": "4.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "obs-studio-node": "file:../obs-studio-node",
    "socket.io-client": "^4.8.4"
  },
  "build": {
    "appId": "com.screensh.app",
    "productName": "ScreenSh",
    "asar": true,
    "asarUnpack": [
      "node_modules/obs-studio-node/**/*"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "main.js",
      "preload.js",
      "managed-process.js",
      "peer-test.js",
      "member-ping.cjs",
      "obs-engine.js",
      "obs-host-path.js",
      "voice-runtime.cjs",
      "voice-worker.cjs",
      "obs-constants.js",
      "capture-sources.js",
      "mediamtx.yml",
      "renderer/**/*",
      "node_modules/**/*",
      "package.json",
      "process-audio.cjs",
      "video-encoder.js",
      "tray-controller.cjs"
    ],
    "extraResources": [
      {
        "from": "res",
        "to": ".",
        "filter": [
          "**/*",
          "!mediamtx.yml"
        ]
      },
      {
        "from": "mediamtx.yml",
        "to": "mediamtx.yml"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "ScreenSh-${version}-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "werrtiiii",
        "repo": "screensh"
      }
    ]
  }
}
