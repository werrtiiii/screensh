{
  "name": "screensh",
  "version": "1.5.0",
  "description": "P2P Screen Sharing Application",
  "main": "main.js",
  "scripts": {
    "pack:win": "npm run build:lolping && npm run build:process-audio && electron-builder --win nsis --publish never",
    "publish:win": "npm run build:lolping && npm run build:process-audio && electron-builder --win nsis --publish always",
    "pack:portable": "npm run build:lolping && npm run build:process-audio && node scripts/package-win.cjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "build:icons": "node scripts/build-icons.cjs",
    "test": "node --test tests/*.test.js",
    "test:chat": "node scripts/run-electron.cjs smoke-chat.cjs",
    "test:native": "node scripts/run-electron.cjs smoke-native.cjs",
    "test:media": "node scripts/run-electron.cjs smoke-electron.cjs",
    "test:ui": "node scripts/run-electron.cjs smoke-ui.cjs",
    "test:voice": "node scripts/run-electron.cjs smoke-voice.cjs",
    "test:mic-meter": "node scripts/run-electron.cjs smoke-mic-meter.cjs",
    "test:speaking": "node scripts/run-electron.cjs smoke-speaking.cjs",
    "test:voice-ui": "node scripts/run-electron.cjs smoke-voice-ui.cjs",
    "build:process-audio": "node scripts/build-process-audio.cjs",
    "build:lolping": "node scripts/build-lolping.cjs",
    "prestart": "npm run build:lolping",
    "predev": "npm run build:lolping",
    "pretest": "node scripts/build-lolping.cjs --js-only",
    "test:lolping": "node scripts/run-electron.cjs smoke-lolping.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.12",
    "rcedit": "4.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "obs-studio-node": "file:../obs-studio-node",
    "socket.io-client": "^4.8.4"
  },
  "build": {
    "appId": "com.screensh.app",
    "productName": "ScreenSh",
    "asar": true,
    "asarUnpack": [
      "node_modules/obs-studio-node/**/*"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "assets/branding/icon.png",
      "assets/branding/tray.png",
      "mediamtx.yml",
      "renderer/**/*",
      "node_modules/**/*",
      "package.json",
      "update-config.json",
      "lolping/*.cjs",
      "lolping/dist/**/*",
      "lolping/NOTICE.md",
      "lolping/vendor/LICENSE"
    ],
    "extraResources": [
      {
        "from": "res",
        "to": ".",
        "filter": [
          "**/*",
          "!mediamtx.yml"
        ]
      },
      {
        "from": "mediamtx.yml",
        "to": "mediamtx.yml"
      }
    ],
    "win": {
      "icon": "assets/branding/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "installerIcon": "assets/branding/icon.ico",
      "uninstallerIcon": "assets/branding/icon.ico",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "ScreenSh-${version}-Setup.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "werrtiiii",
        "repo": "screensh"
      }
    ]
  }
}
